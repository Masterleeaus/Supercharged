# Copy to .env and fill in. Never commit real values.

# One-time setup token required by POST /api/installer/install.
# Set a long random value before the first install, send it in the
# X-Install-Token header, and clear or rotate it after install.
# Leave empty and the installer stays disabled.
INSTALL_SETUP_TOKEN=

# Database (single PostgreSQL database; see docs/TENANCY.md).
# DATABASE_URL=postgres://<login role>:<password>@<host>:5432/<database>
# Optional restricted role used by withTenant(). Leave commented to use the default desk_app.
# DESK_APP_DB_ROLE=desk_app
