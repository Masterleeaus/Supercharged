diff --git a/server/services/audit-queue.mjs b/server/services/audit-queue.mjs
new file mode 100644
index 0000000..d634c49
--- /dev/null
+++ b/server/services/audit-queue.mjs
@@ -0,0 +1,99 @@
+/**
+ * Database-free audit buffer with retry.
+ *
+ * Rows stay in memory until an insert succeeds. A failed insert puts the rows
+ * back at the front of the queue (order preserved) and schedules a retry with
+ * exponential backoff. A row is reported as lost only in two cases, and both
+ * are reported through onLoss, never silently:
+ *   - it failed maxAttempts times in a row ("max_attempts"), or
+ *   - the queue is over maxQueue rows and the oldest rows are shed
+ *     ("queue_overflow"), which bounds memory during a long outage.
+ *
+ * Kept as a plain .mjs module (no db or config imports) so it can be unit-tested
+ * with `node --test` without connecting to anything.
+ */
+
+export const DEFAULT_MAX_ATTEMPTS = 5;
+export const DEFAULT_MAX_QUEUE = 10000;
+export const DEFAULT_FLUSH_DELAY_MS = 5000;
+export const DEFAULT_BASE_RETRY_MS = 5000;
+export const DEFAULT_MAX_RETRY_MS = 60000;
+
+export function createAuditBuffer({
+  insert,
+  onLoss = () => {},
+  schedule = (fn, ms) => setTimeout(fn, ms),
+  maxAttempts = DEFAULT_MAX_ATTEMPTS,
+  maxQueue = DEFAULT_MAX_QUEUE,
+  flushDelayMs = DEFAULT_FLUSH_DELAY_MS,
+  baseRetryMs = DEFAULT_BASE_RETRY_MS,
+  maxRetryMs = DEFAULT_MAX_RETRY_MS,
+}) {
+  if (typeof insert !== 'function') throw new TypeError('createAuditBuffer: insert must be a function');
+
+  let queue = []; // { row, attempts }
+  let timer = null;
+  let consecutiveFailures = 0;
+  const stats = { written: 0, retried: 0, lost: 0 };
+
+  function scheduleFlush(ms) {
+    if (timer) return;
+    timer = schedule(() => {
+      timer = null;
+      return flush();
+    }, ms);
+  }
+
+  function shedOverflow() {
+    if (queue.length <= maxQueue) return;
+    const shed = queue.splice(0, queue.length - maxQueue);
+    stats.lost += shed.length;
+    onLoss(shed.map((item) => item.row), 'queue_overflow');
+  }
+
+  function push(row) {
+    queue.push({ row, attempts: 0 });
+    shedOverflow();
+    scheduleFlush(flushDelayMs);
+  }
+
+  async function flush() {
+    if (queue.length === 0) return { written: 0, pending: 0 };
+
+    const batch = queue;
+    queue = [];
+
+    try {
+      await insert(batch.map((item) => item.row));
+      stats.written += batch.length;
+      consecutiveFailures = 0;
+      return { written: batch.length, pending: queue.length };
+    } catch (error) {
+      consecutiveFailures += 1;
+      const retry = [];
+      const exhausted = [];
+      for (const item of batch) {
+        item.attempts += 1;
+        (item.attempts < maxAttempts ? retry : exhausted).push(item);
+      }
+      if (exhausted.length > 0) {
+        stats.lost += exhausted.length;
+        onLoss(exhausted.map((item) => item.row), 'max_attempts', error);
+      }
+      stats.retried += retry.length;
+      queue = [...retry, ...queue];
+      shedOverflow();
+      if (queue.length > 0) {
+        const delay = Math.min(maxRetryMs, baseRetryMs * 2 ** (consecutiveFailures - 1));
+        scheduleFlush(delay);
+      }
+      return { written: 0, pending: queue.length, error };
+    }
+  }
+
+  return {
+    push,
+    flush,
+    stats: () => ({ ...stats, pending: queue.length }),
+  };
+}
